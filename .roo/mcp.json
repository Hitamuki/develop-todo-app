{
  "mcpServers": {
    "mcp-installer": {
      "command": "npx",
      "args": [
        "@anaisbetts/mcp-installer"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "alwaysAllow": [
        "create_branch",
        "create_or_update_file",
        "search_repositories",
        "create_issue",
        "create_pull_request",
        "get_issue",
        "search_issues",
        "get_pull_request"
      ],
      "owner": "Hitamuki",
      "repo": "develop-todo-app",
      "branch": "develop"
    }
  }
}
