{
  "name": "frontend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "api:generate": "npx rimraf ./src/app/api && openapi-generator-cli generate --config ./openapitools.json --generator-key frontend",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e-report": "playwright show-report",
    "format": "prettier --write src",
    "lint:ts": "ng lint",
    "lint:css": "stylelint \"./src/**/*.{scss,component.ts,css,sass}\"",
    "lint:html": "markuplint \"./src/**/*.{html}\"",
    "lint:fix": "eslint --cache --fix src/ && prettier --write src && stylelint \"./src/**/*.{scss,component.ts,css,sass}\" --fix && markuplint \"./src/**/*.html\"",
    "format:biome": "biome format ./src",
    "format:biome-action": "biome format --write ./src",
    "lint:biome": "biome lint ./src",
    "lint:biome-action": "biome lint --write ./src",
    "check:eslint": "eslint --inspect-config"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.0.0",
    "@angular/cdk": "18.2.11",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/material": "18.2.11",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/router": "^18.0.0",
    "@ng-bootstrap/ng-bootstrap": "^17.0.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-builders/jest": "^18.0.0",
    "@angular-devkit/build-angular": "^18.0.3",
    "@angular/cli": "^18.0.3",
    "@angular/compiler-cli": "^18.0.0",
    "@angular/localize": "^18.0.0",
    "@biomejs/biome": "1.9.2",
    "@openapitools/openapi-generator-cli": "^2.15.3",
    "@playwright/test": "^1.47.2",
    "@testing-library/angular": "^17.3.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/eslint-plugin-security": "^3",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.6.1",
    "angular-eslint": "18.3.1",
    "biome": "^0.3.3",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.5.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.2.4",
    "markuplint": "^3.15.0",
    "markuplint-angular-parser": "^2.0.0",
    "playwright": "^1.47.2",
    "postcss": "^8.4.47",
    "postcss-angular": "^1.0.3",
    "prettier": "^3.3.3",
    "stylelint": "^16.10.0",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-recommended-scss": "^14.1.0",
    "typescript": "~5.4.2",
    "typescript-eslint": "^8.15.0"
  },
  "volta": {
    "node": "20.14.0",
    "yarn": "4.5.2"
  }
}
